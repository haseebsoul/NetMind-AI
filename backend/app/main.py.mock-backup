from fastapi import FastAPI, HTTPException
from fastapi.middleware.cors import CORSMiddleware
from pydantic import BaseModel
from typing import List, Optional
import uvicorn
from .network_monitor import NetworkMonitor

app = FastAPI(title="NetMind AI API", version="1.0.0")

# CORS
app.add_middleware(
    CORSMiddleware,
    allow_origins=["*"],
    allow_credentials=True,
    allow_methods=["*"],
    allow_headers=["*"],
)

# Models
class Device(BaseModel):
    id: int
    name: str
    ip: str
    status: str
    cpu: float
    memory: float
    latency: float
    uptime: str
    type: str
    location: str
    temperature: float

class DeviceCreate(BaseModel):
    name: str
    ip: str
    type: str
    status: str
    location: str
    cpu: float = 50
    memory: float = 50
    latency: float = 10

class DeviceUpdate(BaseModel):
    name: Optional[str] = None
    status: Optional[str] = None
    location: Optional[str] = None
    cpu: Optional[float] = None
    memory: Optional[float] = None
    latency: Optional[float] = None

# Mock data
devices_db = [
    Device(id=1, name="Router-01", ip="192.168.1.1", status="online", cpu=45, memory=60, latency=10, uptime="12d 4h", type="router", location="Server Room A", temperature=42),
    Device(id=2, name="Switch-02", ip="192.168.1.2", status="online", cpu=30, memory=45, latency=7, uptime="8d 2h",type="switch", location="Server Room A", temperature=38),
    Device(id=3, name="Server-03", ip="192.168.1.3", status="warning", cpu=85, memory=78, latency=17, uptime="30d 0h", type="server", location="Data Center B", temperature=55),
    Device(id=4, name="Firewall-04", ip="192.168.1.4", status="online", cpu=25, memory=35, latency=5, uptime="20d 6h", type="firewall", location="Security Zone", temperature=35),
    Device(id=5, name="AP-05", ip="192.168.1.5", status="warning", cpu=70, memory=55, latency=35, uptime="2d 12h", type="access-point", location="Floor 3", temperature=48),
    Device(id=6, name="Gateway-06", ip="192.168.1.6", status="online", cpu=20, memory=30, latency=6, uptime="15d 3h", type="gateway", location="Main Entrance", temperature=32),
]

# Initialize Network Monitor
network_monitor = NetworkMonitor()

# ----- ORIGINAL ROUTES -----
@app.get("/")
def root():
    return {"message": "NetMind AI API", "version": "1.0.0"}

@app.get("/api/devices", response_model=List[Device])
def get_devices():
    return devices_db

@app.get("/api/devices/{device_id}", response_model=Device)
def get_device(device_id: int):
    device = next((d for d in devices_db if d.id == device_id), None)
    if not device:
        raise HTTPException(status_code=404, detail="Device not found")
    return device

@app.post("/api/devices", response_model=Device)
def create_device(device: DeviceCreate):
    new_id = max([d.id for d in devices_db]) + 1 if devices_db else 1
    new_device = Device(
        id=new_id,
        name=device.name,
        ip=device.ip,
        status=device.status,
        cpu=device.cpu,
        memory=device.memory,
        latency=device.latency,
        uptime="0d 0h",
        type=device.type,
        location=device.location,
        temperature=30
    )
    devices_db.append(new_device)
    return new_device

@app.put("/api/devices/{device_id}", response_model=Device)
def update_device(device_id: int, device_update: DeviceUpdate):
    device = next((d for d in devices_db if d.id == device_id), None)
    if not device:
        raise HTTPException(status_code=404, detail="Device not found")
    
    if device_update.name is not None:
        device.name = device_update.name
    if device_update.status is not None:
        device.status = device_update.status
    if device_update.location is not None:
        device.location = device_update.location
    if device_update.cpu is not None:
        device.cpu = device_update.cpu
    if device_update.memory is not None:
        device.memory = device_update.memory
    if device_update.latency is not None:
        device.latency = device_update.latency
    
    return device

@app.delete("/api/devices/{device_id}")
def delete_device(device_id: int):
    device = next((d for d in devices_db if d.id == device_id), None)
    if not device:
        raise HTTPException(status_code=404, detail="Device not found")
    devices_db.remove(device)
    return {"message": "Device deleted successfully"}

@app.get("/api/health")
def health_check():
    online = len([d for d in devices_db if d.status == "online"])
    warning = len([d for d in devices_db if d.status == "warning"])
    offline = len([d for d in devices_db if d.status == "offline"])
    return {
        "total": len(devices_db),
        "online": online,
        "warning": warning,
        "offline": offline,
        "status": "healthy" if online > 0 else "critical"
    }

# ----- NEW NETWORK SWITCHING ROUTES -----
@app.get("/api/network/status")
async def get_network_status():
    \"\"\"Get current network interfaces with signal strengths.\"\"\"
    interfaces = network_monitor.scan_interfaces()
    network_monitor.update_signals()
    return {
        "interfaces": interfaces,
        "active": network_monitor.active_interface,
        "history": network_monitor.switch_history[:5]
    }

@app.get("/api/network/ai-decision")
async def get_ai_decision():
    \"\"\"Get AI recommendation based on signals.\"\"\"
    network_monitor.scan_interfaces()
    network_monitor.update_signals()
    decision = network_monitor.ai_decision()
    return decision

@app.post("/api/network/switch")
async def manual_switch(from_iface: str = None, to_iface: str = None):
    \"\"\"Manually trigger a switch.\"\"\"
    if not from_iface or not to_iface:
        decision = network_monitor.ai_decision()
        if decision.get("decision") == "switch":
            from_iface = decision.get("from")
            to_iface = decision.get("to")
        else:
            return {"status": "no_switch_needed", "message": "AI does not recommend a switch"}

    if from_iface and to_iface and from_iface != to_iface:
        result = network_monitor.perform_switch(from_iface, to_iface)
        return {"status": "switched", "result": result}
    return {"status": "error", "message": "Invalid switch parameters"}

if __name__ == "__main__":
    uvicorn.run(app, host="0.0.0.0", port=8000)
