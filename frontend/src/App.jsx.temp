{/* ===== NETWORK TOPOLOGY ===== */}
<div style={{
  marginBottom: '24px'
}}>
  <h3 style={{ 
    fontSize: '16px', 
    fontWeight: '600', 
    color: isDark ? 'white' : '#1a1a2e',
    marginBottom: '12px'
  }}>
    🕸️ Network Topology
  </h3>
